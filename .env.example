# Lyceum never reads provider keys from the environment in production builds.
# Keys are entered in-app and stored in the OS keychain (desktop) or encrypted vault (web).
# These variables exist ONLY for local development and live-provider contract tests.
LYCEUM_TEST_OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
LYCEUM_TEST_OPENAI_COMPATIBLE_KEY=
LYCEUM_TEST_ANTHROPIC_KEY=
LYCEUM_TEST_OPENAI_KEY=
LYCEUM_TEST_OPENROUTER_KEY=
