{
  "name": "lyceum",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Lyceum: a local-first, model-agnostic mastery tutor for any subject.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "overrides": {
      "@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1",
      "workbox-build@7.4.1>glob": "14.0.3"
    }
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "eval": "pnpm --filter @lyceum/eval eval",
    "test:watch": "vitest",
    "storybook": "storybook dev --no-open -p 6006",
    "storybook:build": "storybook build",
    "test:ui": "playwright test",
    "web:build": "pnpm --filter @lyceum/web build",
    "test:web": "playwright test --config playwright.web.config.ts",
    "boundaries": "node scripts/check-boundaries.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "verify": "pnpm boundaries && pnpm agentcheck && pnpm typecheck && pnpm test && pnpm eval && pnpm lint",
    "agentcheck": "node scripts/check-agent-files.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.8",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
